{
  "name": "@trellis/client",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./rpcSpec": "./rpcSpec.ts",
    "./channelSpec": "./channelSpec.ts",
    "./server": "./server/index.ts"
  },
  "imports": {
    "#rpcSpec": "./rpcSpec.ts",
    "#channelSpec": "./channelSpec.ts",
    "#server/*": "./server/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@trellis/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.1.8",
    "esbuild": "^0.28.2",
    "tsx": "^4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  }
}
